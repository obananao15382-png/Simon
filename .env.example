DISCORD_TOKEN=your_discord_bot_token
TOGETHER_API_KEY=your_together_api_key
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507
# OpenAI-compatible chat completions endpoint for Together AI
AI_BASE_URL=https://api.together.xyz/v1

# Channel IDs allowed to receive occasional unsolicited messages and bot-to-bot replies.
# Leave empty to disable both features; @mentions from humans still work everywhere.
SPONTANEOUS_CHANNEL_IDS=
SPONTANEOUS_CHANCE=0.85
SPONTANEOUS_COOLDOWN_SECONDS=90
BOT_REPLY_CHANCE=0.40
BOT_REPLY_COOLDOWN_SECONDS=180
CHANNEL_REPLY_LIMIT_PER_HOUR=6

# Topic-aware unsolicited replies (higher threshold = fewer interruptions)
AWARENESS_THRESHOLD=2
AWARENESS_CHANCE=1.0
